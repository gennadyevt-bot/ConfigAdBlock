<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fillViewport="true">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="32dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Config AdBlock"
        android:textColor="@color/white_bg"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/white_bg"
        android:textSize="12sp"
        android:layout_marginBottom="24dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ВКЛЮЧИТЬ"
        android:textSize="18sp"
        android:backgroundTint="@color/white_bg"
        android:textColor="@color/green_primary"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chkHttps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HTTPS-фильтрация (режет баннеры)"
        android:textColor="@color/white_bg"
        android:buttonTint="@color/white_bg"
        android:layout_marginTop="20dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="УСТАНОВИТЬ СЕРТИФИКАТ"
        android:textSize="13sp"
        android:backgroundTint="@color/white_bg"
        android:textColor="@color/green_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="8dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ИСКЛЮЧЁННЫЕ ПРИЛОЖЕНИЯ"
        android:textSize="13sp"
        android:backgroundTint="@color/white_bg"
        android:textColor="@color/green_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="8dp" />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chkBrowsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="только браузеры (все приложения работают)"
        android:textColor="@color/white_bg"
        android:buttonTint="@color/white_bg"
        android:layout_marginTop="4dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetCa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="СБРОСИТЬ СЕРТИФИКАТ"
        android:textSize="13sp"
        android:backgroundTint="#FFD54F"
        android:textColor="@color/green_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="8dp" />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chkNoMitm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="отладка: без MITM (direct)"
        android:textColor="@color/white_bg"
        android:buttonTint="@color/white_bg"
        android:layout_marginTop="4dp" />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chkEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="пустой туннель (только VPN, без движка)"
        android:textColor="@color/white_bg"
        android:buttonTint="@color/white_bg"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Всего запросов: 0
Заблокировано: 0
Пропущено: 0"
        android:textColor="@color/white_bg"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        android:gravity="center" />
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        android:gravity="center" />
</LinearLayout>
</ScrollView>
