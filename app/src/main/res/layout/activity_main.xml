<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:minHeight="640dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/adblock_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Config AdBlock"
            android:textColor="@color/white_bg"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <Space android:layout_width="1dp" android:layout_height="46dp" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Защита выключена"
            android:textColor="@color/white_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Нажмите кнопку, чтобы убрать рекламу"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="280dp"
            android:layout_height="68dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/white_bg"
            android:stateListAnimator="@null"
            android:text="ВКЛЮЧИТЬ"
            android:textColor="@color/green_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space android:layout_width="1dp" android:layout_height="46dp" />

        <TextView
            android:id="@+id/btnSettingsExpand"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Настройки  ›"
            android:textColor="@color/white_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkHttps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/white_bg"
                android:text="HTTPS-фильтрация"
                android:textColor="@color/white_bg" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkBrowsers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/white_bg"
                android:text="Только браузеры"
                android:textColor="@color/white_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCert"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Установить сертификат"
                android:textColor="@color/white_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApps"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:text="Исключённые приложения"
                android:textColor="@color/white_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCa"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:backgroundTint="#FFD54F"
                android:text="Сбросить сертификат"
                android:textColor="@color/green_dark" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkNoMitm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отладка: без MITM"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пустой туннель"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvYandexCb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/white_bg"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYandexCb"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="Настроить Яндекс.Браузер" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#45FFFFFF" />

        <TextView
            android:id="@+id/btnStatsExpand"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Статистика и журнал  ›"
            android:textColor="@color/white_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/statsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:textColor="@color/white_bg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:textColor="#FFF2B2"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
